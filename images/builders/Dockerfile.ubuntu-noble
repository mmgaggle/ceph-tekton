# syntax=docker/dockerfile:1.6
#
# ceph-builder:ubuntu-noble-<arch> — Containerfile for the Ubuntu
# 24.04 LTS (noble) Ceph build environment.
#
# Companion to Dockerfile.ubuntu-jammy. Same Stage 0–3 structure;
# the deltas vs jammy are:
#   - FROM docker.io/library/ubuntu:24.04 (noble) vs :22.04.
#   - Toolchain: noble ships gcc 13 + glibc 2.39 + python 3.12
#     (one major release behind centos10's gcc 14, but within the
#     range install-deps.sh handles).
#   - `universe` is enabled by default in the noble base image,
#     but the explicit `add-apt-repository universe` is kept for
#     robustness against minimal-base variants.
#   - `equivs` was moved from `main` to `universe` between jammy
#     and noble; the universe enable is what keeps it reachable.
#
# See Dockerfile.centos10 for the cross-cutting rationale (UID
# 1000, sudo shim, install-deps.sh pin, OCI labels), and
# Dockerfile.ubuntu-jammy for the apt-specific commentary —
# duplicated comments are NOT replayed here to keep this file
# scannable.

# --- Stage 0: base ----------------------------------------------------
FROM docker.io/library/ubuntu:24.04 AS builder-base

# --- Build args -------------------------------------------------------
ARG CEPH_REPO=https://github.com/ceph/ceph.git
ARG CEPH_SHA=8f95d0ea294fe1f063cd1c46ca7ddcb48f6f223e
ARG INSTALL_DEPS_FOR_MAKE_CHECK=true
ARG SOURCE_DATE_EPOCH
ARG BUILDER_IMAGE_VERSION=0.1.0-ubuntu-noble
ARG OCI_IMAGE_SOURCE=https://github.com/mmgaggle/ceph-tekton
ARG OCI_IMAGE_REVISION=unknown
ARG OCI_IMAGE_CREATED=unknown

ENV DEBIAN_FRONTEND=noninteractive \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8

# --- Stage 1: install build deps + ceph toolchain ---------------------
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        software-properties-common \
        gnupg; \
    add-apt-repository -y universe; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        sudo \
        git \
        wget \
        curl \
        tar \
        xz-utils \
        bzip2 \
        zstd \
        diffutils \
        findutils \
        file \
        make \
        cmake \
        ninja-build \
        ccache \
        build-essential \
        pkg-config \
        python3 \
        python3-pip \
        python3-dev \
        python3-venv \
        dpkg-dev \
        debhelper \
        devscripts \
        fakeroot \
        equivs \
        lsb-release; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# --- Stage 2: fetch ceph/ceph at pinned SHA + run install-deps.sh -----
RUN set -eux; \
    mkdir -p /usr/src/ceph; \
    cd /usr/src/ceph; \
    git init -q; \
    git remote add origin "${CEPH_REPO}"; \
    git fetch --depth=1 origin "${CEPH_SHA}"; \
    git checkout -q FETCH_HEAD; \
    git log -1 --pretty='format:ceph/ceph @ %H (%ci)%n  %s' >&2; \
    printf '#!/bin/sh\nexec "$@"\n' > /usr/local/bin/sudo; \
    chmod +x /usr/local/bin/sudo; \
    export FOR_MAKE_CHECK="${INSTALL_DEPS_FOR_MAKE_CHECK}"; \
    ./install-deps.sh; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*; \
    find /usr/src/ceph -maxdepth 1 -mindepth 1 \
        ! -name 'debian' \
        ! -name 'install-deps.sh' \
        ! -name '.git' \
        -exec rm -rf {} +; \
    find /usr/src/ceph/debian -maxdepth 1 -mindepth 1 \
        ! -name 'control' \
        ! -name 'control.in' \
        ! -name 'rules' \
        -exec rm -rf {} + 2>/dev/null || true; \
    rm -rf /usr/src/ceph/.git

# --- Stage 3: build user + entrypoint ---------------------------------
# Noble ships a default `ubuntu` user at UID 1000 in the base
# image — we have to delete it before adding our `builder` at UID
# 1000, otherwise useradd fails with "UID 1000 already in use".
# Jammy doesn't have this; the conditional deluser is a noble-
# specific quirk.
RUN set -eux; \
    if id -u ubuntu >/dev/null 2>&1; then \
        userdel -r ubuntu 2>/dev/null || true; \
    fi; \
    groupadd --system --gid 1000 builder; \
    useradd  --system --uid 1000 --gid builder \
             --home-dir /home/builder --create-home --shell /bin/bash builder; \
    mkdir -p /home/builder/build /home/builder/ccache; \
    chown -R builder:builder /home/builder; \
    install -d -o builder -g builder /home/builder/.ccache; \
    printf 'max_size = 5G\ncache_dir = /home/builder/.ccache\n' \
        > /home/builder/.ccache/ccache.conf; \
    chown builder:builder /home/builder/.ccache/ccache.conf

COPY --chown=root:root build-package.sh /usr/local/bin/build-package.sh
RUN chmod 0755 /usr/local/bin/build-package.sh

RUN set -eux; \
    { \
      printf 'CEPH_BUILDER_IMAGE_TITLE=ceph-builder-ubuntu-noble\n'; \
      printf 'CEPH_BUILDER_IMAGE_VERSION=%s\n' "${BUILDER_IMAGE_VERSION}"; \
      printf 'CEPH_BUILDER_CEPH_SHA=%s\n'      "${CEPH_SHA}"; \
      printf 'CEPH_BUILDER_DISTRO=ubuntu-noble\n'; \
      printf 'CEPH_BUILDER_FOR_MAKE_CHECK=%s\n' "${INSTALL_DEPS_FOR_MAKE_CHECK}"; \
      printf 'CEPH_BUILDER_SOURCE_DATE_EPOCH=%s\n' "${SOURCE_DATE_EPOCH:-}"; \
    } > /etc/ceph-builder-image.env

LABEL org.opencontainers.image.source="${OCI_IMAGE_SOURCE}" \
      org.opencontainers.image.revision="${OCI_IMAGE_REVISION}" \
      org.opencontainers.image.created="${OCI_IMAGE_CREATED}" \
      org.opencontainers.image.title="ceph-builder-ubuntu-noble" \
      org.opencontainers.image.description="Ubuntu 24.04 (noble) builder image for ceph/ceph, pre-baked with install-deps.sh output." \
      org.opencontainers.image.licenses="LGPL-2.1-or-later" \
      org.opencontainers.image.url="https://github.com/mmgaggle/ceph-tekton" \
      org.opencontainers.image.documentation="https://github.com/mmgaggle/ceph-tekton/blob/main/docs/builder-images.md" \
      org.ceph.builder-image.version="${BUILDER_IMAGE_VERSION}" \
      org.ceph.builder-image.ceph-sha="${CEPH_SHA}" \
      org.ceph.builder-image.distro="ubuntu-noble" \
      org.ceph.builder-image.for-make-check="${INSTALL_DEPS_FOR_MAKE_CHECK}"

USER builder
WORKDIR /home/builder/build

ENTRYPOINT ["/usr/local/bin/build-package.sh"]
CMD []
