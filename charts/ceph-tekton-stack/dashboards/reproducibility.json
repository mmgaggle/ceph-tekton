        "legend": {
          "calcs": [
            "lastNotNull",
            "min",
            "mean"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "tekton_pipelinerun_result{name=\"pct_match\", pipeline=~\"$pipeline\"}",
          "instant": false,
          "legendFormat": "{{namespace}}/{{pipelinerun}} ({{pipeline}})",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Reproducibility % — pct_match over time",
      "type": "timeseries"
    }
  ],
